# Modelo local
LLAMA_BASE_URL=http://127.0.0.1:8081/v1
LLAMA_API_KEY=local
LLAMA_MODEL=local-qwen3-4b
LLM_TIMEOUT_SECONDS=180
TEMPERATURE=0.6
MAX_TOKENS=900

# Persistência
DB_PATH=./data/assistant.sqlite3
MAX_HISTORY_MESSAGES=12

# CORS (apenas loopback)
CORS_ORIGIN_REGEX=^http://(127\.0\.0\.1|localhost):\d+$

# Ferramentas de leitura (Etapa 2)
TOOLS_ENABLED=true
# CSV de raízes absolutas. Vazio desliga a família de arquivos.
TOOL_READ_ROOTS=
TOOL_DENY_GLOBS=.env,.git/**,.ssh/**,.gnupg/**,*.pem,id_rsa*,node_modules/**,.venv/**
TOOL_MAX_FILE_BYTES=262144
TOOL_MAX_ENTRIES=200
TOOL_MAX_RESULTS=50
TOOL_SEARCH_TIMEOUT_SECONDS=5
TOOL_RESULT_MAX_CHARS=4000
AGENT_MAX_TOOL_ROUNDS=4
AGENT_MAX_TOOL_CALLS=6
PROCESS_LIST_DEFAULT_LIMIT=15
PROCESS_LIST_MAX_LIMIT=50
GPU_QUERY_TIMEOUT_SECONDS=2
