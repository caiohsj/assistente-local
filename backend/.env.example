# Modelo local
LLAMA_BASE_URL=http://127.0.0.1:8081/v1
LLAMA_API_KEY=local
LLAMA_MODEL=local-qwen3-4b
LLM_TIMEOUT_SECONDS=180
TEMPERATURE=0.6
MAX_TOKENS=900

# Persistência
DB_PATH=./data/assistant.sqlite3
MAX_HISTORY_MESSAGES=12

# CORS: loopback (Vite) + origens exatas do WebView Tauri. Nunca use `*`.
# Quem já tem .env precisa copiar esta linha manualmente.
CORS_ORIGIN_REGEX=^(?:http://(?:127\.0\.0\.1|localhost):\d+|tauri://localhost|http://tauri\.localhost)$

# Ferramentas de leitura (Etapa 2)
TOOLS_ENABLED=false
# CSV de raízes absolutas. Vazio desliga a família de arquivos.
TOOL_READ_ROOTS=
TOOL_DENY_GLOBS=.env,.git/**,.ssh/**,.gnupg/**,*.pem,id_rsa*,node_modules/**,.venv/**
TOOL_MAX_FILE_BYTES=262144
TOOL_MAX_ENTRIES=200
TOOL_MAX_RESULTS=50
TOOL_SEARCH_TIMEOUT_SECONDS=5
TOOL_RESULT_MAX_CHARS=4000
AGENT_MAX_TOOL_ROUNDS=4
AGENT_MAX_TOOL_CALLS=6
PROCESS_LIST_DEFAULT_LIMIT=15
PROCESS_LIST_MAX_LIMIT=50
GPU_QUERY_TIMEOUT_SECONDS=2

# Abertura de aplicativos e sites (Etapa 3)
# A família apps liga junto com TOOLS_ENABLED; não existe TOOL_OPEN_ENABLED.
TOOL_OPEN_URL_COMMAND=xdg-open
# CSV de domínios permitidos (host exato ou subdomínio). Vazio libera qualquer domínio.
TOOL_OPEN_URL_DOMAINS=
TOOL_OPEN_URL_MAX_CHARS=2048
# Aliases tentam os candidatos na ordem e usam o primeiro instalado.
TOOL_OPEN_APP_ALIASES=terminal=x-terminal-emulator|gnome-terminal|konsole|alacritty|kitty|xterm
# CSV de executáveis bloqueados. Vazio respeita "qualquer executável do PATH".
# Também aceita IDs Flatpak (ex.: org.telegram.desktop).
TOOL_OPEN_APP_DENY=

# Captura por voz (Etapa 4)
# Habilita o recurso. O frontend também precisa de VITE_VOICE_ENABLED=true.
# No navegador usa a Web Speech API; no Tauri/Linux grava WAV e transcreve
# localmente via /transcribe (faster-whisper). Wake word mantém o mic ativo.
VOICE_ENABLED=false
VOICE_WAKE_WORD=mestre
VOICE_LANGUAGE=pt-BR

# STT local (usado no WebView Tauri, que não tem Web Speech API).
# O modelo é baixado do HuggingFace no primeiro uso e mantido em memória.
# tiny é o menor e mais rápido; base/small são mais precisos e mais lentos.
VOICE_STT_MODEL=tiny
VOICE_STT_DEVICE=cpu
VOICE_STT_COMPUTE_TYPE=int8
# Código de idioma do Whisper (pt, en, auto...).
VOICE_STT_LANGUAGE=pt
# Limite do corpo enviado a /transcribe (10 MiB por padrão).
VOICE_MAX_AUDIO_BYTES=10485760
