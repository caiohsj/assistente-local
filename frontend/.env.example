VITE_API_BASE=http://127.0.0.1:8765

# Captura por voz. O backend também precisa de VOICE_ENABLED=true.
# No Tauri/Linux a transcrição é local (faster-whisper); no navegador usa Web Speech API.
# Ambas as opções precisam estar ativadas para o microfone funcionar.
VITE_VOICE_ENABLED=false
# Idioma da transcrição (BCP 47). O backend anuncia o padrão em /health.
VITE_VOICE_LANGUAGE=pt-BR
